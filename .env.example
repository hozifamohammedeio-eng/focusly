# Find both values in Supabase Dashboard → Project Settings → API.
# The publishable key is intentionally safe for browser use and is still
# protected by PostgreSQL grants and Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Trusted app origin for confirmation/recovery redirects. Use localhost for local testing.
SITE_URL=https://focusly-beige.vercel.app

# Server-only. Enable after the complete Focusly 2 migration chain and reward
# RPCs are verified in the target database. Omit/false for the current backend.
FOCUSLY2_REWARDS_ENABLED=false
